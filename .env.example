# Axiom Observatory Environment Configuration
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000

# Storage
DATABASE_URL=sqlite:///./axiom_observatory.db

# Authentication (Planned Keycloak / OIDC Broker)
AUTH_MODE=demo
OIDC_ISSUER_URL=http://127.0.0.1:8080/realms/axiom
OIDC_CLIENT_ID=axiom-observatory
OIDC_CLIENT_SECRET=

# Advisory LLM Configuration (Optional, Server-Side Only)
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=
LLM_API_KEY=
